# Supabase PostgreSQL connection string.
# Replace the placeholder with the database password from Supabase project settings.
# Never put a Supabase REST API key or service-role key in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.jzuqjibyqpcoxjmyuqoe.supabase.co:5432/postgres?sslmode=require

# Frontend origin allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development
